{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mefoot-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": { "name": "mefoot-staging", "vars": { "APP_ENV": "staging" } },
    "production": { "name": "mefoot", "vars": { "APP_ENV": "production" } }
  }
}
