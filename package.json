{
  "name": "mefoot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --env staging --local --port 8787",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "check:worker": "wrangler deploy --dry-run --env staging --outdir .worker-check",
    "release": "node scripts/release.mjs",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "smoke": "node scripts/smoke.mjs",
    "start:api": "node server/index.ts",
    "db:migrate": "node server/migrate.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260914.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "dependencies": {
    "jose": "6.2.12",
    "pg": "8.23.0"
  }
}
